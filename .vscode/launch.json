{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "frontend",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal"
        },
        {
            "name": "backend",
            "type": "debugpy",
            "request": "launch",
            "program": "manage.py",
            "args": ["runserver", "0.0.0.0:8000"],
            "django": true,
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "fullstack",
            "configurations": ["backend", "frontend"],
            "stopAll": true
        }
    ]
}
